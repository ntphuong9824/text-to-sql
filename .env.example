# Copy to .env (gitignored) and fill in. The app imports ./.env itself
# (spring.config.import: optional:file:.env[.properties]), so run it from the repo root.
# Real environment variables take precedence over values in .env.
LLM_API_KEY=
# Optional (leave commented out to use the defaults; an empty value would override them):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash-lite
# At least 32 bytes.
JWT_SECRET=
